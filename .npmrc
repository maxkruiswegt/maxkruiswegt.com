# Supply-chain cooldown (npm 11.10+): a version must be a week old before an install or update resolves
# to it; most malicious releases are caught and pulled within hours to days. Versions already in the
# lockfile still install (npm ci is unaffected). An urgent fix can bypass it once:
# `npm install <pkg> --min-release-age=0`. `npm audit signatures` looks every locked version up again,
# so it needs the same flag while the lockfile holds one younger than a week.
min-release-age=7

# No dependencies from git repos (npm 11.10+, npm 12's default): none of ours is one, and a git
# dependency can run code at install even with scripts off.
allow-git=none

# No install scripts, the usual way a compromised package runs code on install. This project has no
# lifecycle scripts of its own, and the native packages that ship one (esbuild, @parcel/watcher,
# unrs-resolver) also ship prebuilt binaries as optional dependencies, so they work without it.
# A new dependency that genuinely needs its script: run it by hand with `npm rebuild <pkg> --ignore-scripts=false`.
ignore-scripts=true
